# -----------------------------------------------------------
# La Mesa del Duque — .gitignore
# -----------------------------------------------------------
# Secretos y configuración local (NUNCA incluir en el repositorio)
# -----------------------------------------------------------
appsettings.Development.json
appsettings.*.json
!appsettings.json
appsettings.*.local.json
*.local.json
.env
.env.*
*.pfx
*.pem
*.key
*.crt
secrets.json
credentials.json

# -----------------------------------------------------------
# Registros (logs)
# -----------------------------------------------------------
*.log
logs/
Logs/
NLog-*
serilog-*

# -----------------------------------------------------------
# Artefactos de compilación (.NET)
# -----------------------------------------------------------
[Bb]in/
[Oo]bj/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
.vs/
*.DotSettings.user

# -----------------------------------------------------------
# Resultados de pruebas
# -----------------------------------------------------------
TestResults/
**/TestResults/
*.coverage
*.coveragexml
coveragereport/
.coverage.*

# -----------------------------------------------------------
# Artefactos de calidad (generados localmente y en CI)
# -----------------------------------------------------------
artifacts/

# -----------------------------------------------------------
# Paquetes NuGet
# -----------------------------------------------------------
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
nuget.exe

# -----------------------------------------------------------
# Archivos de sistema operativo
# -----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
# SQLite dev database
lmd-dev.db
lmd-dev.db-shm
lmd-dev.db-wal
Desktop.ini

# -----------------------------------------------------------
# Entornos virtuales Python (si se usan herramientas auxiliares)
# -----------------------------------------------------------
venv/
.venv/
__pycache__/

# -----------------------------------------------------------
# Archivos temporales y de edición
# -----------------------------------------------------------
*.swp
*.swo
*~
*.orig
*.tmp
*.bak

# -----------------------------------------------------------
# Herramientas locales de planificación y flujo de trabajo
# -----------------------------------------------------------
.atl/
openspec/
.claude/
.codex/
.agent/
.agents/
.serena/
.cursor/
.windsurf/
.mcp/
.sdd/
.worktrees/
AGENTS.md
CLAUDE.md
SERENA.md
dogfood-output/
docs/superpowers/
README-APLICAR-FIXES.md
README-SUPERFIX.md
aplicar-fixes.ps1
aplicar-superfix.ps1
lmd-superfix/
lmd-superfix-*/
lmd-migrations.db
qa-output/
.codex-runtime/
