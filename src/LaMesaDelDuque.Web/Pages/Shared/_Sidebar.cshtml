@{
    var activeTab = ViewData["ActiveTab"]?.ToString() ?? "";
    var esAdmin = User.IsInRole("Administrador");
    var esEncargado = User.IsInRole("Encargado");
    var puedeCatalogo = esAdmin || esEncargado;
    var puedeSalon = esAdmin || esEncargado;
    var puedeTurno = esAdmin || esEncargado;
    var puedePanel = esAdmin || esEncargado;
    var puedeSistema = esAdmin;

    var rolLabel = esAdmin ? "Administrador"
        : esEncargado ? "Encargado"
        : User.IsInRole("Mesero") ? "Mesero"
        : User.IsInRole("Cajero") ? "Cajero"
        : User.IsInRole("Cocinero") ? "Cocinero"
        : "Usuario";
}

<aside class="lmd-sidebar" id="lmdSidebar" role="navigation" aria-label="Menú principal">

    <div class="lmd-sidebar__header">
        <img src="~/img/marca/logo-simbolo.png" alt="La Mesa del Duque" class="lmd-sidebar__logo" />
        <span class="lmd-sidebar__brand">La Mesa del Duque</span>
        <button class="lmd-sidebar__toggle-btn" id="lmdSidebarToggle" aria-label="Colapsar menú">
            <i class="bi bi-layout-sidebar-reverse"></i>
        </button>
    </div>

    <nav class="lmd-sidebar__nav">

        @if (puedePanel)
        {
            <div class="lmd-sidebar__section">
                <span class="lmd-sidebar__section-label">Panel</span>
                <a asp-page="/Admin/Dashboard/Dashboard"
                   class="lmd-sidebar__item @(activeTab == "Dashboard" ? "lmd-sidebar__item--active" : "")"
                   title="Dashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
            </div>
        }

        @if (puedeCatalogo)
        {
            <div class="lmd-sidebar__section">
                <span class="lmd-sidebar__section-label">Catálogo</span>
                <a asp-page="/Operaciones/Productos/Index"
                   class="lmd-sidebar__item @(activeTab == "Productos" ? "lmd-sidebar__item--active" : "")"
                   title="Productos">
                    <i class="bi bi-box-seam"></i>
                    <span>Productos</span>
                </a>
                <a asp-page="/Operaciones/Inventario/Index"
                   class="lmd-sidebar__item @(activeTab == "Inventario" ? "lmd-sidebar__item--active" : "")"
                   title="Inventario">
                    <i class="bi bi-archive"></i>
                    <span>Inventario</span>
                </a>
            </div>
        }

        @if (puedeSalon)
        {
            <div class="lmd-sidebar__section">
                <span class="lmd-sidebar__section-label">Salón</span>
                <a asp-page="/Operaciones/Mesas/Index"
                   class="lmd-sidebar__item @(activeTab == "Mesas" ? "lmd-sidebar__item--active" : "")"
                   title="Mesas">
                    <i class="bi bi-grid"></i>
                    <span>Mesas</span>
                </a>
                <a asp-page="/Operaciones/Salon/Mapa"
                   class="lmd-sidebar__item @(activeTab == "Mapa" ? "lmd-sidebar__item--active" : "")"
                   title="Mapa del salón">
                    <i class="bi bi-map"></i>
                    <span>Mapa del salón</span>
                </a>
                <a asp-page="/Operaciones/Delivery/Index"
                   class="lmd-sidebar__item @(activeTab == "Delivery" ? "lmd-sidebar__item--active" : "")"
                   title="Delivery">
                    <i class="bi bi-truck"></i>
                    <span>Delivery</span>
                </a>
            </div>
        }

        @if (puedeTurno)
        {
            <div class="lmd-sidebar__section">
                <span class="lmd-sidebar__section-label">Turno</span>
                <a asp-page="/Cocina/KDS"
                   class="lmd-sidebar__item @(activeTab == "Cocina" ? "lmd-sidebar__item--active" : "")"
                   title="KDS Cocina">
                    <i class="bi bi-display"></i>
                    <span>KDS Cocina</span>
                </a>
                <a asp-page="/Operaciones/Cierre/Index"
                   class="lmd-sidebar__item @(activeTab == "Cierre" ? "lmd-sidebar__item--active" : "")"
                   title="Cierre de caja">
                    <i class="bi bi-cash-stack"></i>
                    <span>Cierre de caja</span>
                </a>
            </div>
        }

        @if (puedeSistema)
        {
            <div class="lmd-sidebar__section">
                <span class="lmd-sidebar__section-label">Sistema</span>
                <a asp-page="/Admin/Usuarios/Index"
                   class="lmd-sidebar__item @(activeTab == "Usuarios" ? "lmd-sidebar__item--active" : "")"
                   title="Usuarios">
                    <i class="bi bi-people"></i>
                    <span>Usuarios</span>
                </a>
            </div>
        }

    </nav>

    <div class="lmd-sidebar__footer">
        <div class="lmd-sidebar__user">
            <i class="bi bi-person-circle"></i>
            <div class="lmd-sidebar__user-info">
                <span class="lmd-sidebar__username">@User.Identity?.Name</span>
                <span class="lmd-sidebar__userrole">@rolLabel</span>
            </div>
        </div>
        <form method="post" asp-page="/Auth/Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="lmd-sidebar__logout" title="Cerrar sesión">
                <i class="bi bi-box-arrow-right"></i>
                <span>Cerrar sesión</span>
            </button>
        </form>
    </div>

</aside>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var sidebar  = document.getElementById('lmdSidebar');
    var toggle   = document.getElementById('lmdSidebarToggle');
    var shell    = document.getElementById('lmdShellMain');
    var backdrop = document.getElementById('lmdSidebarBackdrop');
    var mobileBtn = document.getElementById('lmdMobileMenuBtn');
    var KEY = 'lmd-sidebar-col-v2';
    var OLD_KEY = 'lmd-sidebar-col';
    var isMobile = function () { return window.matchMedia('(max-width: 767.98px)').matches; };

    try { localStorage.removeItem(OLD_KEY); localStorage.removeItem(KEY); } catch (e) {}

    function abrirMobile() {
        if (!sidebar) return;
        sidebar.classList.remove('lmd-sidebar--collapsed');
        shell?.classList.remove('lmd-shell-with-sidebar--collapsed');
        sidebar.classList.add('lmd-sidebar--mobile-open');
        backdrop?.classList.add('lmd-sidebar-backdrop--visible');
        document.body.classList.add('lmd-sidebar-mobile-lock');
    }

    function cerrarMobile() {
        sidebar?.classList.remove('lmd-sidebar--mobile-open');
        backdrop?.classList.remove('lmd-sidebar-backdrop--visible');
        document.body.classList.remove('lmd-sidebar-mobile-lock');
    }

    function aplicarEstadoDesktop() {
        if (!sidebar || !shell) return;
        if (isMobile()) {
            sidebar.classList.remove('lmd-sidebar--collapsed');
            shell.classList.remove('lmd-shell-with-sidebar--collapsed');
            cerrarMobile();
            return;
        }
        sidebar.classList.remove('lmd-sidebar--collapsed');
        shell.classList.remove('lmd-shell-with-sidebar--collapsed');
    }

    aplicarEstadoDesktop();

    toggle?.addEventListener('click', function () {
        if (isMobile() || !sidebar) return;
        var colapsado = !sidebar.classList.contains('lmd-sidebar--collapsed');
        sidebar.classList.toggle('lmd-sidebar--collapsed', colapsado);
        shell?.classList.toggle('lmd-shell-with-sidebar--collapsed', colapsado);
        try { localStorage.setItem(KEY, colapsado ? '1' : '0'); } catch (e) {}
    });

    mobileBtn?.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        if (sidebar?.classList.contains('lmd-sidebar--mobile-open')) cerrarMobile();
        else abrirMobile();
    });

    backdrop?.addEventListener('click', cerrarMobile);

    sidebar?.querySelectorAll('.lmd-sidebar__item').forEach(function (item) {
        item.addEventListener('click', function () { if (isMobile()) cerrarMobile(); });
    });

    window.addEventListener('resize', aplicarEstadoDesktop);
});
</script>
