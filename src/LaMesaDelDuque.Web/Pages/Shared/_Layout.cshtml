<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="La Mesa del Duque — Operaciones" />
    <title>@ViewData["Title"] — La Mesa del Duque</title>
    <link rel="icon" type="image/png" href="~/img/marca/logo-simbolo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/marca.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LaMesaDelDuque.Web.styles.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.json" />
</head>
<body>
    <div id="lmd-offline-banner" class="lmd-offline-banner" style="display:none;">
        <span id="lmd-offline-texto">Modo offline</span>
        <span id="lmd-offline-pendientes" class="lmd-offline-pendientes-badge" style="display:none;"></span>
    </div>
    <nav class="navbar navbar-expand-lg lmd-ops-nav">
        <div class="container lmd-shell-container">
            <a class="navbar-brand lmd-ops-brand" asp-page="/Index">
                <img src="~/img/marca/canvas.png" alt="La Mesa del Duque" style="height:40px;" />
                <span>La Mesa del Duque</span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ops-nav-collapse"
                    aria-controls="ops-nav-collapse" aria-expanded="false" aria-label="Menú de navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse" id="ops-nav-collapse">
                <ul class="navbar-nav lmd-module-tabs mx-auto">
                    @{
                        var esAdmin = User.IsInRole("Administrador");
                        var esEncargado = User.IsInRole("Encargado");
                        var esMesero = User.IsInRole("Mesero");
                        var esCocinero = User.IsInRole("Cocinero");
                    }
                    @if (esAdmin || esEncargado)
                    {
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveTab"]?.ToString() == "Productos" ? "active" : "")"
                           asp-page="/Operaciones/Productos/Index">Productos</a>
                    </li>
                    }
                    @if (esAdmin || esEncargado || esMesero)
                    {
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveTab"]?.ToString() == "Mesas" ? "active" : "")"
                           asp-page="/Operaciones/Mesas/Index">Mesas</a>
                    </li>
                    }
                    @if (esAdmin || esEncargado || esMesero)
                    {
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActiveTab"]?.ToString() == "Pedidos" ? "active" : "")"
                           asp-page="/Operaciones/Pedidos/Index">Pedidos</a>
                    </li>
                    }
                    @if (esCocinero || esEncargado || esAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveTab"]?.ToString() == "Cocina" ? "active" : "")"
                               asp-page="/Cocina/KDS">COCINA</a>
                        </li>
                    }
                    @if (esAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveTab"]?.ToString() == "Usuarios" ? "active" : "")"
                               asp-page="/Admin/Usuarios/Index">Usuarios</a>
                        </li>
                    }
                    @if (esAdmin || esEncargado)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveTab"]?.ToString() == "Inventario" ? "active" : "")"
                               asp-page="/Operaciones/Inventario/Index">Inventario</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActiveTab"]?.ToString() == "Cierre" ? "active" : "")"
                               asp-page="/Operaciones/Cierre/Index">Cierre</a>
                        </li>
                    }
                </ul>

                <div class="lmd-user-info d-flex align-items-center gap-2 ms-auto">
                    <span class="lmd-user-name">@User.Identity.Name</span>
                    <form method="post" asp-page="/Auth/Logout" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm lmd-action-neutral">Salir</button>
                    </form>
                </div>
            </div>
            }
        </div>
    </nav>

    <div class="container lmd-shell-container lmd-shell-main">
        <main role="main" class="lmd-main-surface">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/js/sw.js').catch(function(err) {
                console.warn('SW registration failed:', err);
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
