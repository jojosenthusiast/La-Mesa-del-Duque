@page
@model LaMesaDelDuque.Web.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Registro de empleado";
}

<div class="row justify-content-center mt-4 mb-4">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <img src="~/img/marca/logo-simbolo.png" alt="La Mesa del Duque" style="height:48px;margin-bottom:0.5rem;" />
                    <h3 class="card-title mb-0">Registro de empleado</h3>
                    <p class="text-muted small mb-0">Crea una cuenta usando la clave asignada para tu rol.</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.MensajeError))
                {
                    <div class="alert alert-danger">@Model.MensajeError</div>
                }

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Username" class="form-label">Usuario</label>
                        <input asp-for="Input.Username" class="form-control" required autocomplete="username" />
                        <span asp-validation-for="Input.Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.NombreCompleto" class="form-label">Nombre completo</label>
                        <input asp-for="Input.NombreCompleto" class="form-control" required autocomplete="name" />
                        <span asp-validation-for="Input.NombreCompleto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Password" class="form-label">Contraseña</label>
                            <input asp-for="Input.Password" type="password" class="form-control" required autocomplete="new-password" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contraseña</label>
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" required autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 mt-3">
                        <label asp-for="Input.ClaveRol" class="form-label">Clave de rol</label>
                        <input asp-for="Input.ClaveRol" class="form-control" required placeholder="Ej: CAJERO-567" autocomplete="off" />
                        <span asp-validation-for="Input.ClaveRol" class="text-danger"></span>
                        <div class="form-text">La clave define si la cuenta será cajero, cocina o encargado.</div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Crear cuenta</button>
                </form>

                <hr class="my-3" />
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="text-muted small">¿Ya tienes usuario?</span>
                    <a asp-page="/Auth/Login" class="btn btn-outline-secondary btn-sm">Volver al login</a>
                </div>

                <div class="alert alert-info small mt-3 mb-0">
                    <strong>Claves demo:</strong>
                    <code>CAJERO-567</code>, <code>COCINA-456</code>, <code>ENCARGADO-321</code>.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
