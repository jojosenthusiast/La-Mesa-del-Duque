@page
@using LaMesaDelDuque.Dominio.Enumeraciones
@model LaMesaDelDuque.Web.Pages.Operaciones.Inventario.IndexModel
@{
    ViewData["Title"] = "Inventario";
    ViewData["ActiveTab"] = "Inventario";
}

<section class="lmd-page-header rounded-top"><h1>Inventario</h1><p class="lmd-page-subtitle">Ingredientes, proveedores y control de stock.</p></section>

<section class="bg-white p-0 rounded-bottom">

    <div class="lmd-toast-zone px-3 pt-3">
        @if (!string.IsNullOrWhiteSpace(Model.ToastSuccess))
        {
            <div class="alert alert-success alert-dismissible fade show py-2 mb-2" role="status">@Model.ToastSuccess<button type="button" class="btn-close" aria-label="Cerrar"></button></div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ToastError))
        {
            <div class="alert alert-danger alert-dismissible fade show py-2 mb-2" role="alert">@Model.ToastError<button type="button" class="btn-close" aria-label="Cerrar"></button></div>
        }
    </div>

    <nav class="lmd-inv-tabs" id="lmd-inv-nav">
        <button class="lmd-inv-tab active" data-tab="ingredientes">Ingredientes</button>
        <button class="lmd-inv-tab" data-tab="proveedores">Proveedores</button>
        <button class="lmd-inv-tab" data-tab="mermas">Mermas</button>
    </nav>

    <div class="lmd-inv-panel active" id="panel-ingredientes">
        <table class="table table-striped"><thead><tr><th>Nombre</th><th>Stock</th><th>Min</th><th>UnidadMedida</th><th>Costo U.</th><th>Proveedor</th></tr></thead>
        <tbody>
        @foreach(var i in Model.Ingredientes){
            var urg = i.StockActual <= i.StockMinimo ? "table-danger" : i.StockActual <= i.StockMinimo*1.5m ? "table-warning" : "";
            <tr class="@urg"><td>@i.Nombre</td><td>@i.StockActual</td><td>@i.StockMinimo</td><td>@i.UnidadMedida</td><td>@i.CostoUnitario.ToString("C")</td><td>@i.Proveedor</td></tr>
        }
        </tbody></table>
    </div>

    <div class="lmd-inv-panel" id="panel-proveedores">
        <table class="table table-striped"><thead><tr><th>Nombre</th><th>Contacto</th><th>Teléfono</th><th>Email</th></tr></thead>
        <tbody>
        @foreach(var p in Model.Proveedores){<tr><td>@p.Nombre</td><td>@p.Contacto</td><td>@p.Telefono</td><td>@p.Email</td></tr>}
        </tbody></table>
    </div>

    <div class="lmd-inv-panel" id="panel-mermas">
        <div class="p-3 border-bottom">
            <h6 class="fw-bold mb-3">Registrar merma</h6>
            <form method="post" asp-page-handler="RegistrarMerma">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label form-label-sm" asp-for="MermaForm.IngredienteId">Ingrediente</label>
                        <select class="form-select form-select-sm" asp-for="MermaForm.IngredienteId">
                            <option value="">— Seleccionar —</option>
                            @foreach (var ing in Model.Ingredientes)
                            {
                                <option value="@ing.Id">@ing.Nombre (@ing.UnidadMedida)</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="MermaForm.IngredienteId"></span>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label form-label-sm" asp-for="MermaForm.Cantidad">Cantidad</label>
                        <input type="number" step="0.001" min="0.001" class="form-control form-control-sm" asp-for="MermaForm.Cantidad" />
                        <span class="text-danger small" asp-validation-for="MermaForm.Cantidad"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm" asp-for="MermaForm.Tipo">Tipo</label>
                        <select class="form-select form-select-sm" asp-for="MermaForm.Tipo">
                            @foreach (TipoMerma tipo in Enum.GetValues(typeof(TipoMerma)))
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm" asp-for="MermaForm.Lote">Lote (opcional)</label>
                        <input class="form-control form-control-sm" asp-for="MermaForm.Lote" maxlength="50" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label form-label-sm" asp-for="MermaForm.Notas">Notas (opcional)</label>
                        <input class="form-control form-control-sm" asp-for="MermaForm.Notas" maxlength="500" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-sm lmd-action-success w-100">Registrar</button>
                    </div>
                </div>
            </form>
        </div>

        <table class="table table-striped mb-0"><thead><tr><th>Ingrediente</th><th>Cant.</th><th>Costo</th><th>Tipo</th><th>Lote</th><th>Notas</th><th>Hora</th></tr></thead>
        <tbody>
        @if(Model.Mermas.Count == 0){<tr><td colspan="7" class="text-muted text-center py-3">Sin mermas registradas hoy.</td></tr>}
        @foreach(var m in Model.Mermas){
            <tr><td>@m.IngredienteNombre</td><td>@m.Cantidad</td><td>@m.Costo.ToString("C")</td><td>@m.Tipo</td><td>@(m.Lote ?? "—")</td><td>@(m.Notas ?? "—")</td><td>@m.Fecha.ToString("HH:mm")</td></tr>
        }
        </tbody></table>
    </div>
</section>

<style>
.lmd-inv-tabs{display:flex;gap:0;border-bottom:2px solid var(--lmd-marfil-oscuro)}
.lmd-inv-tab{appearance:none;border:none;background:transparent;padding:.75rem 1.5rem;font-weight:600;cursor:pointer;min-height:48px;color:var(--lmd-gris-piedra);border-bottom:2px solid transparent;margin-bottom:-2px}
.lmd-inv-tab.active,.lmd-inv-tab:hover{color:var(--lmd-dorado-real);border-bottom-color:var(--lmd-dorado-real)}
.lmd-inv-panel{display:none}
.lmd-inv-panel.active{display:block}
</style>

@section Scripts{
<partial name="_ValidationScriptsPartial" />
<script>
(function(){
    var tabs = document.querySelectorAll('.lmd-inv-tab');
    var panels = document.querySelectorAll('.lmd-inv-panel');
    function activate(tab){
        tabs.forEach(function(t){t.classList.remove('active')});
        panels.forEach(function(p){p.classList.remove('active')});
        tab.classList.add('active');
        document.getElementById('panel-'+tab.dataset.tab).classList.add('active');
        history.replaceState(null,'',location.pathname+'#'+tab.dataset.tab);
    }
    tabs.forEach(function(b){b.addEventListener('click',function(){activate(b)})});
    var hash = location.hash.replace('#','');
    if(hash){
        var target = document.querySelector('[data-tab="'+hash+'"]');
        if(target) activate(target);
    }
})();
</script>}
