@page
@using LaMesaDelDuque.Dominio.Enumeraciones
@model LaMesaDelDuque.Web.Pages.Operaciones.Inventario.IndexModel
@{
    ViewData["Title"] = "Inventario";
    ViewData["ActiveTab"] = "Inventario";
}

<section class="lmd-page-header rounded-top"><h1>Inventario</h1></section>

<section class="bg-white p-0 rounded-bottom">

    <div class="lmd-toast-zone px-3 pt-3">
        @if (!string.IsNullOrWhiteSpace(Model.ToastSuccess))
        {
            <div class="alert alert-success alert-dismissible fade show py-2 mb-2" role="status">@Model.ToastSuccess<button type="button" class="btn-close" aria-label="Cerrar"></button></div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ToastError))
        {
            <div class="alert alert-danger alert-dismissible fade show py-2 mb-2" role="alert">@Model.ToastError<button type="button" class="btn-close" aria-label="Cerrar"></button></div>
        }
    </div>

    <nav class="lmd-inv-tabs" id="lmd-inv-nav">
        <button class="lmd-inv-tab active" data-tab="ingredientes">Ingredientes</button>
        <button class="lmd-inv-tab" data-tab="proveedores">Proveedores</button>
        <button class="lmd-inv-tab" data-tab="mermas">Mermas</button>
    </nav>

    <div class="lmd-inv-panel active" id="panel-ingredientes">
        <form method="post" asp-page-handler="@(Model.EditIngredienteId.HasValue ? "EditarIngrediente" : "CrearIngrediente")" class="p-3 border-bottom row g-2 align-items-end">
            @Html.AntiForgeryToken()
            @if (Model.EditIngredienteId.HasValue)
            {
                <input type="hidden" name="Id" value="@Model.EditIngredienteId.Value" />
            }
            <div class="col-md-3"><label class="form-label form-label-sm">Nombre</label><input name="Nombre" class="form-control form-control-sm" required value="@Model.IngForm.Nombre" /></div>
            <div class="col-md-1"><label class="form-label form-label-sm">Stock</label><input name="StockActual" type="number" step="0.01" class="form-control form-control-sm" required value="@Model.IngForm.StockActual" /></div>
            <div class="col-md-1"><label class="form-label form-label-sm">Mínimo</label><input name="StockMinimo" type="number" step="0.01" class="form-control form-control-sm" required value="@Model.IngForm.StockMinimo" /></div>
            <div class="col-md-1"><label class="form-label form-label-sm">Unidad</label><input name="UnidadMedida" class="form-control form-control-sm" value="@(string.IsNullOrEmpty(Model.IngForm.UnidadMedida) ? "unidad" : Model.IngForm.UnidadMedida)" /></div>
            <div class="col-md-1"><label class="form-label form-label-sm">Costo U.</label><input name="CostoUnitario" type="number" step="0.01" class="form-control form-control-sm" required value="@Model.IngForm.CostoUnitario" /></div>
            <div class="col-md-2"><label class="form-label form-label-sm">Proveedor</label><select name="ProveedorId" class="form-select form-select-sm"><option value="">—</option>@foreach(var p in Model.Proveedores){<option value="@p.Id" selected="@(Model.IngForm.ProveedorId == p.Id)">@p.Nombre</option>}</select></div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-sm lmd-action-success w-100">
                    @(Model.EditIngredienteId.HasValue ? "Guardar" : "+ Crear")
                </button>
            </div>
            @if (Model.EditIngredienteId.HasValue)
            {
                <div class="col-md-1"><a href="?tab=ingredientes" class="btn btn-sm btn-outline-secondary w-100">Cancelar</a></div>
            }
        </form>
        <table class="table table-striped"><thead><tr><th>Nombre</th><th>Stock</th><th>Mín</th><th>Unidad</th><th>Costo U.</th><th>Proveedor</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach(var i in Model.Ingredientes){
            var urg = i.StockActual <= i.StockMinimo ? "table-danger" : i.StockActual <= i.StockMinimo*1.5m ? "table-warning" : "";
            <tr class="@urg @(i.Activo ? "" : "text-muted")">
                <td>@i.Nombre @(!i.Activo ? Html.Raw("<span class=\"badge bg-secondary ms-1\">Inactivo</span>") : "")</td>
                <td>@i.StockActual</td><td>@i.StockMinimo</td><td>@i.UnidadMedida</td>
                <td>@i.CostoUnitario.ToString("C")</td><td>@(i.Proveedor ?? "—")</td>
                <td class="text-end text-nowrap">
                    <a href="?editIngrediente=@i.Id&tab=ingredientes" class="btn btn-sm lmd-icon-only" title="Editar"><i class="bi bi-pencil"></i></a>
                    <form method="post" asp-page-handler="ToggleIngrediente" class="d-inline"><input type="hidden" name="id" value="@i.Id" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm lmd-icon-only" title="@(i.Activo ? "Desactivar" : "Activar")"><i class="bi @(i.Activo ? "bi-toggle-on text-success" : "bi-toggle-off text-secondary")"></i></button></form>
                </td>
            </tr>
        }
        </tbody></table>
    </div>

    <div class="lmd-inv-panel" id="panel-proveedores">
        <form method="post" asp-page-handler="@(Model.EditProveedorId.HasValue ? "EditarProveedor" : "CrearProveedor")" class="p-3 border-bottom row g-2 align-items-end">
            @Html.AntiForgeryToken()
            @if (Model.EditProveedorId.HasValue)
            {
                <input type="hidden" name="Id" value="@Model.EditProveedorId.Value" />
            }
            <div class="col-md-3"><label class="form-label form-label-sm">Nombre</label><input name="Nombre" class="form-control form-control-sm" required value="@Model.PrvForm.Nombre" /></div>
            <div class="col-md-2"><label class="form-label form-label-sm">NIT</label><input name="Nit" class="form-control form-control-sm" required value="@Model.PrvForm.Nit" /></div>
            <div class="col-md-2"><label class="form-label form-label-sm">Contacto</label><input name="Contacto" class="form-control form-control-sm" value="@Model.PrvForm.Contacto" /></div>
            <div class="col-md-2"><label class="form-label form-label-sm">Teléfono</label><input name="Telefono" class="form-control form-control-sm" value="@Model.PrvForm.Telefono" /></div>
            @if (Model.EditProveedorId.HasValue)
            {
            <div class="col-md-2"><label class="form-label form-label-sm">Email</label><input name="Email" type="email" class="form-control form-control-sm" value="@Model.PrvForm.Email" /></div>
            <div class="col-md-2"><label class="form-label form-label-sm">Dirección</label><input name="Direccion" class="form-control form-control-sm" value="@Model.PrvForm.Direccion" /></div>
            }
            <div class="col-md-1">
                <button type="submit" class="btn btn-sm lmd-action-success w-100">
                    @(Model.EditProveedorId.HasValue ? "Guardar" : "+ Crear")
                </button>
            </div>
            @if (Model.EditProveedorId.HasValue)
            {
                <div class="col-md-1"><a href="?tab=proveedores" class="btn btn-sm btn-outline-secondary w-100">Cancelar</a></div>
            }
        </form>
        <table class="table table-striped"><thead><tr><th>Nombre</th><th>NIT</th><th>Contacto</th><th>Teléfono</th><th>Email</th><th>Ingredientes</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach(var p in Model.Proveedores){
            var ings = Model.Ingredientes.Where(i => i.ProveedorId == p.Id).ToList();
            <tr class="@(p.Activo ? "" : "text-muted")">
                <td>@p.Nombre @(!p.Activo ? Html.Raw("<span class=\"badge bg-secondary ms-1\">Inactivo</span>") : "")</td>
                <td>@p.Nit</td><td>@(p.Contacto ?? "—")</td><td>@(p.Telefono ?? "—")</td><td>@(p.Email ?? "—")</td>
                <td>@(ings.Count == 0 ? "—" : string.Join(", ", ings.Select(i => i.Nombre)))</td>
                <td class="text-end text-nowrap">
                    <a href="?editProveedor=@p.Id&tab=proveedores" class="btn btn-sm lmd-icon-only" title="Editar"><i class="bi bi-pencil"></i></a>
                    <form method="post" asp-page-handler="ToggleProveedor" class="d-inline"><input type="hidden" name="id" value="@p.Id" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm lmd-icon-only" title="@(p.Activo ? "Desactivar" : "Activar")"><i class="bi @(p.Activo ? "bi-toggle-on text-success" : "bi-toggle-off text-secondary")"></i></button></form>
                </td>
            </tr>
        }
        </tbody></table>
    </div>

    <div class="lmd-inv-panel" id="panel-mermas">
        <div class="p-3 border-bottom">
            <h6 class="fw-bold mb-3">Registrar merma</h6>
            <form method="post" asp-page-handler="RegistrarMerma">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label form-label-sm" asp-for="MermaForm.IngredienteId">Ingrediente</label>
                        <select class="form-select form-select-sm" asp-for="MermaForm.IngredienteId">
                            <option value="">— Seleccionar —</option>
                            @foreach (var ing in Model.Ingredientes)
                            {
                                <option value="@ing.Id">@ing.Nombre (@ing.UnidadMedida)</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="MermaForm.IngredienteId"></span>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label form-label-sm" asp-for="MermaForm.Cantidad">Cantidad</label>
                        <input type="number" step="0.001" min="0.001" class="form-control form-control-sm" asp-for="MermaForm.Cantidad" />
                        <span class="text-danger small" asp-validation-for="MermaForm.Cantidad"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm" asp-for="MermaForm.Tipo">Tipo</label>
                        <select class="form-select form-select-sm" asp-for="MermaForm.Tipo">
                            @foreach (TipoMerma tipo in Enum.GetValues(typeof(TipoMerma)))
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm" asp-for="MermaForm.Lote">Lote (opcional)</label>
                        <input class="form-control form-control-sm" asp-for="MermaForm.Lote" maxlength="50" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label form-label-sm" asp-for="MermaForm.Notas">Notas (opcional)</label>
                        <input class="form-control form-control-sm" asp-for="MermaForm.Notas" maxlength="500" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-sm lmd-action-success w-100">Registrar</button>
                    </div>
                </div>
            </form>
        </div>

        <table class="table table-striped mb-0"><thead><tr><th>Ingrediente</th><th>Cant.</th><th>Costo</th><th>Tipo</th><th>Lote</th><th>Notas</th><th>Hora</th></tr></thead>
        <tbody>
        @if(Model.Mermas.Count == 0){<tr><td colspan="7" class="text-muted text-center py-3">Sin mermas registradas hoy.</td></tr>}
        @foreach(var m in Model.Mermas){
            <tr><td>@m.IngredienteNombre</td><td>@m.Cantidad</td><td>@m.Costo.ToString("C")</td><td>@m.Tipo</td><td>@(m.Lote ?? "—")</td><td>@(m.Notas ?? "—")</td><td>@m.Fecha.ToString("HH:mm")</td></tr>
        }
        </tbody></table>
    </div>
</section>

<style>
.lmd-inv-tabs{display:flex;gap:0;border-bottom:2px solid var(--lmd-marfil-oscuro)}
.lmd-inv-tab{appearance:none;border:none;background:transparent;padding:.75rem 1.5rem;font-weight:600;cursor:pointer;min-height:48px;color:var(--lmd-gris-piedra);border-bottom:2px solid transparent;margin-bottom:-2px}
.lmd-inv-tab.active,.lmd-inv-tab:hover{color:var(--lmd-dorado-real);border-bottom-color:var(--lmd-dorado-real)}
.lmd-inv-panel{display:none}
.lmd-inv-panel.active{display:block}
.lmd-icon-sm{width:18px;height:18px}
.btn.lmd-icon-only{padding:4px 6px;line-height:1;background:transparent;border:1px solid transparent;border-radius:6px;color:var(--lmd-gris-piedra)}
.btn.lmd-icon-only:hover{background:var(--lmd-marfil-oscuro);border-color:var(--lmd-dorado-real)}
</style>

@section Scripts{
<partial name="_ValidationScriptsPartial" />
<script>
(function(){
    var tabs = document.querySelectorAll('.lmd-inv-tab');
    var panels = document.querySelectorAll('.lmd-inv-panel');
    function activate(tab){
        tabs.forEach(function(t){t.classList.remove('active')});
        panels.forEach(function(p){p.classList.remove('active')});
        tab.classList.add('active');
        document.getElementById('panel-'+tab.dataset.tab).classList.add('active');
        history.replaceState(null,'',location.pathname+'#'+tab.dataset.tab);
    }
    tabs.forEach(function(b){b.addEventListener('click',function(){activate(b)})});
    var hash = location.hash.replace('#','');
    var urlTab = new URLSearchParams(location.search).get('tab');
    var targetId = hash || urlTab || 'ingredientes';
    if(targetId){
        var target = document.querySelector('[data-tab="'+targetId+'"]');
        if(target) activate(target);
    }
})();
</script>}
