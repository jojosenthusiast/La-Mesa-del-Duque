@page
@model LaMesaDelDuque.Web.Pages.Operaciones.Pedidos.IndexModel
@{
    ViewData["Title"] = "Pedidos";
}
@Html.AntiForgeryToken()

<section class="lmd-page-header rounded-top">
    <div>
        <h1>Pedidos</h1>
        <p class="lmd-page-subtitle">Terminal de servicio rápido. Toque, seleccione, cobre.</p>
    </div>
</section>

<section class="bg-white p-0 rounded-bottom" id="lmd-pos-contenido">
    <div class="text-center py-5 text-muted">Cargando...</div>
</section>

@{
    var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
}
<script>
    window.__lmdMesasDisponibles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Vm.MesasDisponibles.Select(m => new { m.Id, m.Numero, m.Capacidad, m.Estado, pedidosActivos = new { count = 0, total = 0m } }), jsonOpts));

    window.__lmdProductosDisponibles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Vm.ProductosDisponibles.Select(p => new { p.Id, p.Nombre, p.Precio, p.CategoriaNombre, p.TiempoPreparacionMin, p.ImagenUrl }), jsonOpts));
</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            integrity="sha512-7SRCYIJ8cT6+S4fuC1t7F/LPLoWvMhX7Oxf2N3Qu5jVoYW/P73eBEb0lHNPD0sSR9Cpsu+TtKz9vg8WYkJDtIw=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/pos.js" asp-append-version="true"></script>
}
