@page
@model LaMesaDelDuque.Web.Pages.Operaciones.Pedidos.IndexModel
@{
    ViewData["Title"] = "Pedidos";
    var esComerAqui = Model.Vm.CrearPedido.TipoServicio == "ComerAqui";
    var mesasDisponibles = Model.Vm.MesasDisponibles.Where(m => m.Estado == "Disponible").ToList();
}

<section class="lmd-page-header rounded-top">
    <div>
        <h1>Pedidos</h1>
        <p class="lmd-page-subtitle">Terminal de servicio con flujo rápido y seguro en horario pico.</p>
    </div>
</section>

<section class="bg-white border-top-0 p-4 rounded-bottom">
    <div class="lmd-toast-zone mb-3" id="lmd-toast-zone">
        @if (!string.IsNullOrWhiteSpace(Model.ToastSuccess))
        {
            <div class="alert alert-success alert-dismissible fade show py-2 mb-2" data-lmd-toast="true" role="status">
                @Model.ToastSuccess<button type="button" class="btn-close" aria-label="Cerrar"></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ToastError))
        {
            <div class="alert alert-danger alert-dismissible fade show py-2 mb-2" data-lmd-toast="true" role="alert">
                @Model.ToastError<button type="button" class="btn-close" aria-label="Cerrar"></button>
            </div>
        }
    </div>

    @* ── PANEL DE PAGO (cuando está activo) ── *@
    @if (Model.Vm.MostrarPago && Model.Vm.PedidoActual is not null)
    {
        <div class="border rounded p-4 mb-4 bg-light">
            <h2 class="h5 mb-3">Pagar pedido</h2>
            <div class="mb-3">
                <span class="text-muted">Total a pagar:</span>
                <strong class="lmd-money fs-4 ms-2">@Model.Vm.PedidoActual.Total.ToString("C")</strong>
            </div>

            <form method="post" asp-page-handler="PagarEfectivo" class="mb-3">
                <input type="hidden" name="pedidoId" value="@Model.Vm.PedidoActual.Id" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Efectivo recibido ($)</label>
                        <input type="number" name="efectivoRecibido" step="0.01" min="0"
                               class="form-control form-control-lg lmd-money"
                               value="@(Model.Vm.Pago.EfectivoRecibido?.ToString("F2") ?? Model.Vm.PedidoActual.Total.ToString("F2"))"
                               autofocus />
                    </div>
                    <div class="col-md-4 d-grid">
                        <button type="submit" class="btn btn-lg lmd-action-success">Calcular / Pagar</button>
                    </div>
                    <div class="col-md-4">
                        @if (Model.Vm.Pago.Cambio.HasValue)
                        {
                            <div class="alert alert-success mb-0 py-2 text-center">
                                <small>Cambio</small>
                                <div class="lmd-money fs-4">@Model.Vm.Pago.Cambio.Value.ToString("C")</div>
                            </div>
                        }
                    </div>
                </div>
            </form>

            <form method="post" asp-page-handler="Pagar" class="d-inline me-2">
                <input type="hidden" name="pedidoId" value="@Model.Vm.PedidoActual.Id" />
                <button type="submit" class="btn btn-sm lmd-action-neutral">Pagar sin efectivo (tarjeta/otro)</button>
            </form>
            <a asp-page="./Index" asp-route-PedidoActualId="@Model.Vm.PedidoActual.Id" class="btn btn-sm lmd-action-neutral">Volver al pedido</a>
        </div>
    }

    @* ── FORMULARIO CREAR PEDIDO ── *@
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <form method="post" asp-page-handler="Crear" class="border rounded p-3">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                @* Tipo de servicio — radio buttons *@
                <div class="mb-3">
                    <label class="form-label fw-bold">Tipo de servicio</label>
                    <div class="d-flex gap-3">
                        <label class="form-check form-check-inline border rounded p-2 @(esComerAqui ? "bg-light border-primary" : "")">
                            <input class="form-check-input" type="radio" name="Vm.CrearPedido.TipoServicio"
                                   value="ComerAqui" @(esComerAqui ? "checked" : "")
                                   onchange="this.form.submit()" /> Comer aquí
                        </label>
                        <label class="form-check form-check-inline border rounded p-2 @(!esComerAqui ? "bg-light border-primary" : "")">
                            <input class="form-check-input" type="radio" name="Vm.CrearPedido.TipoServicio"
                                   value="ParaLlevar" @(!esComerAqui ? "checked" : "")
                                   onchange="this.form.submit()" /> Para llevar
                        </label>
                    </div>
                </div>

                @* Mesa — solo ComerAqui, solo disponibles *@
                @if (esComerAqui)
                {
                    <div class="mb-3">
                        <label class="form-label" asp-for="Vm.CrearPedido.MesaId">Mesa</label>
                        <select asp-for="Vm.CrearPedido.MesaId" class="form-select form-select-sm">
                            <option value="">Sin mesa (asignar después)</option>
                            @foreach (var mesa in mesasDisponibles)
                            {
                                <option value="@mesa.Id">Mesa @mesa.Numero (@mesa.Capacidad pers.)</option>
                            }
                        </select>
                        <small class="text-muted">Solo mesas disponibles. @mesasDisponibles.Count mesa(s) libre(s).</small>
                    </div>
                }

                @* Producto inicial *@
                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label" asp-for="Vm.CrearPedido.Lineas[0].ProductoId">Producto inicial</label>
                        <select asp-for="Vm.CrearPedido.Lineas[0].ProductoId" class="form-select form-select-sm">
                            <option value="">Seleccionar producto</option>
                            @foreach (var p in Model.Vm.ProductosDisponibles)
                            {
                                <option value="@p.Id">@p.CategoriaNombre — @p.Nombre (@p.Precio.ToString("C"))</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" asp-for="Vm.CrearPedido.Lineas[0].Cantidad">Cant.</label>
                        <input asp-for="Vm.CrearPedido.Lineas[0].Cantidad" class="form-control form-control-sm" min="1" />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-sm lmd-action-success">Crear</button>
                    </div>
                </div>
            </form>
        </div>

        @* Pedidos activos *@
        <div class="col-lg-6">
            <div class="border rounded p-3">
                <h2 class="h6 mb-2">Pedidos activos</h2>
                @{
                    var pedidosPorMesa = Model.Vm.PedidosActivos.OrderBy(p => p.MesaNumero ?? int.MaxValue).ToList();
                }
                @if (pedidosPorMesa.Count == 0)
                {
                    <div class="lmd-empty-state p-3">No hay pedidos activos.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var pedido in pedidosPorMesa)
                        {
                            <a asp-page="./Index" asp-route-PedidoActualId="@pedido.Id"
                               class="btn btn-sm @(Model.Vm.PedidoActual?.Id == pedido.Id ? "lmd-action-primary" : "lmd-action-neutral")">
                                @(pedido.MesaNumero.HasValue ? $"Mesa {pedido.MesaNumero}" : pedido.TipoServicio) · @pedido.Estado
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── SPLIT WORKSPACE ── *@
    <div class="lmd-pos-shell">
        @* Catálogo de productos *@
        <div class="lmd-pos-catalog">
            <h2 class="h5 mb-3">Productos</h2>
            @if (Model.Vm.ProductosDisponibles.Count == 0)
            {
                <div class="lmd-empty-state">No hay productos activos.</div>
            }
            else
            {
                @foreach (var categoria in Model.Vm.ProductosDisponibles.GroupBy(p => p.CategoriaNombre).OrderBy(g => g.Key))
                {
                    <section class="mb-3">
                        <h3 class="h6 mb-2 bg-light p-2 rounded">@categoria.Key</h3>
                        <div class="d-grid gap-2">
                            @foreach (var producto in categoria)
                            {
                                <form method="post" asp-page-handler="AgregarLinea" class="lmd-pos-line-item border rounded p-2">
                                    <input type="hidden" name="pedidoId" value="@Model.Vm.PedidoActual?.Id" />
                                    <input type="hidden" name="productoId" value="@producto.Id" />
                                    <input type="hidden" name="precioUnitario" value="@producto.Precio" />
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <div class="flex-grow-1">
                                            <strong>@producto.Nombre</strong>
                                            <div class="small lmd-money">@producto.Precio.ToString("C") @(producto.TiempoPreparacionMin > 0 ? $"· {producto.TiempoPreparacionMin}min" : "")</div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="number" name="cantidad" min="1" value="1"
                                                   class="form-control form-control-sm" style="width:72px;" />
                                            <button type="submit" class="btn btn-sm lmd-action-primary"
                                                    @(Model.Vm.PedidoActual is null ? "disabled" : null)>
                                                +
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            }
                        </div>
                    </section>
                }
            }
        </div>

        @* Panel de pedido actual *@
        <aside class="lmd-pos-order-panel">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h5 mb-0">Pedido actual</h2>
                @if (Model.Vm.PedidoActual is not null)
                {
                    <form method="post" asp-page-handler="CambiarTipo" class="d-inline">
                        <input type="hidden" name="pedidoId" value="@Model.Vm.PedidoActual.Id" />
                        <input type="hidden" name="tipoServicio" value="@(Model.Vm.PedidoActual.TipoServicio == "ComerAqui" ? "ParaLlevar" : "ComerAqui")" />
                        <button type="submit" class="btn btn-sm lmd-action-neutral" title="Cambiar tipo">
                            ⇄ @(Model.Vm.PedidoActual.TipoServicio == "ComerAqui" ? "Llevar" : "Aquí")
                        </button>
                    </form>
                }
            </div>

            @if (Model.Vm.PedidoActual is null)
            {
                <div class="lmd-empty-state">Cree o seleccione un pedido para agregar productos.</div>
            }
            else
            {
                <div class="mb-2">
                    <span class="lmd-status-badge lmd-status-badge--busy">@Model.Vm.PedidoActual.Estado</span>
                    <span class="ms-2 small">
                        @(Model.Vm.PedidoActual.MesaNumero.HasValue ? $"Mesa {Model.Vm.PedidoActual.MesaNumero}" : Model.Vm.PedidoActual.TipoServicio)
                    </span>
                </div>

                @if (Model.Vm.PedidoActual.Detalles.Count == 0)
                {
                    <div class="lmd-empty-state">Sin líneas. Agregue productos del catálogo.</div>
                }
                else
                {
                    <div class="d-grid gap-2 mb-3">
                        @foreach (var detalle in Model.Vm.PedidoActual.Detalles)
                        {
                            <article class="lmd-pos-line-item border rounded p-2">
                                <div class="d-flex justify-content-between gap-2 align-items-start">
                                    <div>
                                        <strong>@detalle.ProductoNombre</strong>
                                        <div class="small">@detalle.PrecioUnitario.ToString("C") c/u · Subtotal @detalle.Subtotal.ToString("C")</div>
                                    </div>
                                    <form method="post" asp-page-handler="EliminarLinea" class="lmd-confirm-destructive"
                                          data-confirm-message="¿Quitar @detalle.ProductoNombre?">
                                        <input type="hidden" name="pedidoId" value="@Model.Vm.PedidoActual.Id" />
                                        <input type="hidden" name="detalleId" value="@detalle.Id" />
                                        <button type="submit" class="btn btn-sm lmd-action-danger">✕</button>
                                    </form>
                                </div>
                                <form method="post" asp-page-handler="ActualizarCantidad" class="mt-1 d-flex align-items-center gap-2 lmd-auto-submit-on-change">
                                    <input type="hidden" name="pedidoId" value="@Model.Vm.PedidoActual.Id" />
                                    <input type="hidden" name="detalleId" value="@detalle.Id" />
                                    <label class="small mb-0">Cant:</label>
                                    <input type="number" min="1" name="cantidad" value="@detalle.Cantidad"
                                           class="form-control form-control-sm" style="width:70px;" />
                                </form>
                            </article>
                        }
                    </div>
                }

                <div class="lmd-pos-total mb-3 p-3 bg-light rounded">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Total</span>
                        <strong class="lmd-money fs-4">@Model.Vm.PedidoActual.Total.ToString("C")</strong>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <form method="post" asp-page-handler="MarcarEnPreparacion" class="d-inline">
                        <input type="hidden" name="pedidoId" value="@Model.Vm.PedidoActual.Id" />
                        <button type="submit" class="btn btn-sm lmd-action-primary">En preparación</button>
                    </form>
                    <form method="post" asp-page-handler="AbrirPago" class="d-inline">
                        <input type="hidden" name="pedidoId" value="@Model.Vm.PedidoActual.Id" />
                        <button type="submit" class="btn btn-sm lmd-action-success">💳 Pagar</button>
                    </form>
                </div>

                <div class="lmd-danger-zone pt-2">
                    <form method="post" asp-page-handler="Cancelar" class="lmd-confirm-destructive"
                          data-confirm-message="¿Cancelar este pedido? No se puede deshacer.">
                        <input type="hidden" name="pedidoId" value="@Model.Vm.PedidoActual.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Cancelar pedido</button>
                    </form>
                </div>
            }
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>window.lmdPedidosHubUrl = "/hubs/pedidos";</script>
}
