@page
@model LaMesaDelDuque.Web.Pages.Operaciones.Mesero.IndexModel
@{
    ViewData["Title"] = "Mesero";
}
@Html.AntiForgeryToken()

<nav class="p-3 text-end">
    <a class="btn btn-outline-light btn-sm" asp-page="/Operaciones/Mesero/Handoff">Transferir mesas / cambio de turno</a>
</nav>

@section Styles {
    <link rel="stylesheet" href="~/css/pos-ux.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mesero.css" asp-append-version="true" />
}

<section id="lmd-mesero-contenido">
    <div class="text-center py-5" style="color:#f7f4ec;">Cargando...</div>
</section>

<script>
    window.__lmdProductosMesero = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.ProductosDisponibles.Select(p => new { p.Id, p.Nombre, p.Precio, p.CategoriaNombre, p.TiempoPreparacionMin, p.ImagenUrl, TieneReceta = Model.ProductosConReceta.Contains(p.Id) }),
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
</script>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/mesero.js" asp-append-version="true"></script>
}
