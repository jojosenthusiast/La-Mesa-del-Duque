@page
@model LaMesaDelDuque.Web.Pages.Operaciones.Delivery.IndexModel
@{ ViewData["Title"] = "Resumen de delivery"; ViewData["ActiveTab"] = "Delivery"; }
@Html.AntiForgeryToken()

<section class="lmd-page-header rounded-top">
    <h1>Resumen de delivery</h1>
    <p class="lmd-page-subtitle">Los pedidos a domicilio se crean desde Caja/POS; aquí solo se supervisa y se asignan repartidores.</p>
</section>

<section class="bg-white p-3 rounded-bottom">
    @if (!string.IsNullOrWhiteSpace(Model.ToastSuccess))
    {
        <div class="alert alert-success py-2">@Model.ToastSuccess</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ToastError))
    {
        <div class="alert alert-danger py-2">@Model.ToastError</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="text-muted small">Pedidos delivery</div><div class="fs-3 fw-bold">@Model.Resumen.TotalDomicilio</div></div></div>
        <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="text-muted small">Sin repartidor</div><div class="fs-3 fw-bold text-warning">@Model.Resumen.SinRepartidor</div></div></div>
        <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="text-muted small">En ruta</div><div class="fs-3 fw-bold text-primary">@Model.Resumen.EnRuta</div></div></div>
        <div class="col-md-3"><div class="border rounded p-3 h-100"><div class="text-muted small">Vendido delivery</div><div class="fs-3 fw-bold">@Model.Resumen.VentasDomicilio.ToString("C")</div></div></div>
    </div>

    @if (!Model.Repartidores.Any())
    {
        <div class="alert alert-warning py-2">No hay repartidores activos. Creá usuarios con rol <strong>Repartidor</strong> para asignar envíos.</div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h5 class="mb-0">Pedidos a domicilio</h5>
        <a asp-page="/Operaciones/Pedidos/Index" class="btn btn-dark btn-sm"><i class="bi bi-plus-circle"></i> Crear desde Caja/POS</a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Creado</th>
                    <th>Estado</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Repartidor</th>
                    <th style="min-width:300px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Pedidos.Any())
            {
                <tr><td colspan="8" class="text-muted text-center py-3">No hay pedidos a domicilio.</td></tr>
            }
            @foreach (var p in Model.Pedidos)
            {
                <tr>
                    <td class="small text-muted">@p.FechaCreacion.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    <td>
                        @if (p.Entregado)
                        {
                            <span class="badge bg-success">Entregado</span>
                        }
                        else if (p.RepartidorId.HasValue)
                        {
                            <span class="badge bg-primary">En ruta</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@p.Estado</span>
                        }
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(p.DireccionEntrega) ? "—" : p.DireccionEntrega)</td>
                    <td>@(string.IsNullOrWhiteSpace(p.TelefonoCliente) ? "—" : p.TelefonoCliente)</td>
                    <td>@p.Items</td>
                    <td>@p.Total.ToString("C")</td>
                    <td>@(p.RepartidorNombre ?? "—")</td>
                    <td>
                        @if (!p.Entregado)
                        {
                            <form method="post" asp-page-handler="Asignar" class="d-inline-flex gap-1 align-items-center mb-1 flex-wrap">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="pedidoId" value="@p.Id" />
                                <select name="repartidorId" class="form-select form-select-sm" style="width:auto;" required>
                                    <option value="">Repartidor...</option>
                                    @foreach (var r in Model.Repartidores)
                                    {
                                        <option value="@r.Id" selected="@(p.RepartidorId == r.Id)">@r.Nombre</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Asignar</button>
                            </form>

                            <details class="d-inline-block ms-1">
                                <summary class="btn btn-sm btn-outline-secondary">Editar dirección</summary>
                                <form method="post" asp-page-handler="Datos" class="border rounded p-2 mt-2 bg-light" style="min-width:280px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="pedidoId" value="@p.Id" />
                                    <input name="direccion" class="form-control form-control-sm mb-1" value="@p.DireccionEntrega" maxlength="250" placeholder="Dirección" required />
                                    <input name="telefono" class="form-control form-control-sm mb-1" value="@p.TelefonoCliente" maxlength="30" placeholder="Teléfono" />
                                    <button class="btn btn-sm btn-dark" type="submit">Guardar</button>
                                </form>
                            </details>

                            @if (p.PuedeEntregarse)
                            {
                                <form method="post" asp-page-handler="Entregar" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="pedidoId" value="@p.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">Marcar entregado</button>
                                </form>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">Entregado @(p.EntregadoEn?.ToLocalTime().ToString("HH:mm"))</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
