@page
@model LaMesaDelDuque.Web.Pages.Operaciones.Mesas.IndexModel
@{
    ViewData["Title"] = "Mesas";

    static string BadgeClass(string estado) => estado switch
    {
        "Disponible" => "lmd-status-badge--active",
        "Ocupada" => "lmd-status-badge--busy",
        "Reservada" => "lmd-status-badge--reserved",
        "Mantenimiento" => "lmd-status-badge--danger",
        _ => "lmd-status-badge--neutral"
    };

    static string CardStateClass(string estado) => estado switch
    {
        "Disponible" => "lmd-mesa-card--disponible",
        "Ocupada" => "lmd-mesa-card--ocupada",
        "Reservada" => "lmd-mesa-card--reservada",
        "Mantenimiento" => "lmd-mesa-card--mantenimiento",
        _ => "lmd-mesa-card--inactiva"
    };
}

<section class="lmd-page-header rounded-top">
    <div>
        <h1>Mesas</h1>
        <p class="lmd-page-subtitle">Control visual del estado del salón y transiciones rápidas.</p>
    </div>
    <button class="btn lmd-action-primary" type="button" data-bs-toggle="collapse" data-bs-target="#mesa-form">
        Nueva mesa
    </button>
</section>

<section class="bg-white border-top-0 p-4 rounded-bottom">
    <div class="lmd-toast-zone mb-3">
        @if (!string.IsNullOrWhiteSpace(Model.ToastSuccess))
        {
            <div class="alert alert-success py-2 mb-2">@Model.ToastSuccess</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ToastError))
        {
            <div class="alert alert-danger py-2 mb-2">@Model.ToastError</div>
        }
    </div>

    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var item in Model.Vm.ResumenPorEstado)
        {
            <span class="lmd-status-badge @BadgeClass(item.Key)">@item.Key: @item.Value</span>
        }
    </div>

    <div class="collapse mb-4 @(Model.ModelState.ErrorCount > 0 ? "show" : string.Empty)" id="mesa-form">
        <form method="post" asp-page-handler="Guardar" class="border rounded p-3">
            <input type="hidden" asp-for="Vm.Form.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label" asp-for="Vm.Form.Numero"></label>
                    <input class="form-control form-control-sm" asp-for="Vm.Form.Numero" />
                    <span class="text-danger" asp-validation-for="Vm.Form.Numero"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="Vm.Form.Capacidad"></label>
                    <input class="form-control form-control-sm" asp-for="Vm.Form.Capacidad" />
                    <span class="text-danger" asp-validation-for="Vm.Form.Capacidad"></span>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-sm lmd-action-success">Guardar mesa</button>
            </div>
        </form>
    </div>

    @if (Model.Vm.Mesas.Count == 0)
    {
        <div class="lmd-empty-state">No hay mesas registradas para mostrar.</div>
    }
    else
    {
        <div class="lmd-mesa-grid">
            @foreach (var mesa in Model.Vm.Mesas.OrderBy(m => m.Numero))
            {
                <article class="lmd-mesa-card @CardStateClass(mesa.Estado)">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            <strong>Mesa @mesa.Numero</strong>
                            <div class="small lmd-visually-muted">Capacidad @mesa.Capacidad</div>
                        </div>
                        <span class="lmd-status-badge @BadgeClass(mesa.Estado)">@mesa.Estado</span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <form method="post" asp-page-handler="CambiarEstado" class="d-inline">
                            <input type="hidden" name="id" value="@mesa.Id" />
                            <input type="hidden" name="nuevoEstado" value="Disponible" />
                            <button type="submit" class="btn btn-sm lmd-action-success" @(mesa.Estado == "Disponible" ? "disabled" : null)>Disponible</button>
                        </form>
                        <form method="post" asp-page-handler="CambiarEstado" class="d-inline">
                            <input type="hidden" name="id" value="@mesa.Id" />
                            <input type="hidden" name="nuevoEstado" value="Ocupada" />
                            <button type="submit" class="btn btn-sm lmd-action-primary" @(mesa.Estado == "Ocupada" ? "disabled" : null)>Ocupada</button>
                        </form>
                        <form method="post" asp-page-handler="CambiarEstado" class="d-inline">
                            <input type="hidden" name="id" value="@mesa.Id" />
                            <input type="hidden" name="nuevoEstado" value="Reservada" />
                            <button type="submit" class="btn btn-sm lmd-action-neutral" @(mesa.Estado == "Reservada" ? "disabled" : null)>Reservada</button>
                        </form>
                        <form method="post" asp-page-handler="CambiarEstado" class="d-inline">
                            <input type="hidden" name="id" value="@mesa.Id" />
                            <input type="hidden" name="nuevoEstado" value="Mantenimiento" />
                            <button type="submit" class="btn btn-sm lmd-action-danger" @(mesa.Estado == "Mantenimiento" ? "disabled" : null)>Mantenimiento</button>
                        </form>

                        @if (mesa.Activa)
                        {
                            <form method="post" asp-page-handler="Desactivar" class="d-inline">
                                <input type="hidden" name="id" value="@mesa.Id" />
                                <button type="submit" class="btn btn-sm lmd-action-danger">Desactivar</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
