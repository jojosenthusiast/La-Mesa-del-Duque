@page
@model LaMesaDelDuque.Web.Pages.Operaciones.TurnoCaja.IndexModel
@{ ViewData["Title"] = "Turno de Caja"; ViewData["ActiveTab"] = "Caja"; }
@Html.AntiForgeryToken()

<section class="lmd-page-header rounded-top">
    <h1>Turno de Caja</h1>
    <p class="lmd-page-subtitle">Apertura, cierre de turno y retiros de seguridad.</p>
</section>

<section class="bg-white p-3 rounded-bottom">
    @if (!string.IsNullOrWhiteSpace(Model.ToastError))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3" role="alert">
            @Model.ToastError
            <button type="button" class="btn-close" aria-label="Cerrar"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ToastSuccess))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3" role="alert">
            @Model.ToastSuccess
            <button type="button" class="btn-close" aria-label="Cerrar"></button>
        </div>
    }

    @if (Model.TurnoActivo is null)
    {
        <div class="alert alert-warning mb-3">No hay turno de caja activo. Abrí un turno para comenzar a operar.</div>
        <form method="post" asp-page-handler="Abrir">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Fondo inicial (efectivo en caja)</label>
                    <input type="number" step="0.01" min="0" name="fondoInicial" class="form-control" value="0" required />
                    <div class="form-text">Monto de efectivo con el que iniciás el turno.</div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-success w-100">Abrir Turno</button>
                </div>
            </div>
        </form>
    }
    else
    {
        var t = Model.TurnoActivo;
        <div class="alert alert-success d-flex flex-wrap align-items-center gap-3 mb-3">
            <div>
                <span class="fw-bold">Turno activo</span> —
                Cajero: <strong>@t.CajeroNombre</strong> |
                Apertura: <strong>@t.FechaApertura.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong> |
                Fondo inicial: <strong>@t.FondoInicial.ToString("C")</strong>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <!-- Registrar retiro de seguridad -->
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header fw-semibold">Registrar Retiro de Seguridad</div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="Movimiento">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="turnoId" value="@t.Id" />
                            <input type="hidden" name="tipo" value="retiro_seguridad" />
                            <div class="mb-3">
                                <label class="form-label">Monto</label>
                                <input type="number" step="0.01" min="0.01" name="monto" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Motivo</label>
                                <input type="text" name="motivo" class="form-control" maxlength="300" required placeholder="Ej: Retiro a caja fuerte" />
                            </div>
                            <button type="submit" class="btn btn-outline-warning w-100">Registrar Retiro</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Cerrar turno -->
            <div class="col-md-6">
                <div class="card h-100 border-danger">
                    <div class="card-header fw-semibold text-danger">Cerrar Turno</div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="Cerrar">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="turnoId" value="@t.Id" />
                            <div class="mb-3">
                                <label class="form-label">Efectivo contado en caja</label>
                                <input type="number" step="0.01" min="0" name="efectivoContado" class="form-control" required />
                                <div class="form-text">El sistema calcula el efectivo esperado desde los pagos del turno.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Observación</label>
                                <textarea name="observacion" class="form-control" rows="2" maxlength="500"
                                          placeholder="Obligatoria si hay diferencia de caja."></textarea>
                            </div>
                            <button type="submit" class="btn btn-danger w-100 lmd-confirm-destructive"
                                    data-confirm-message="¿Cerrar el turno? Esta acción no se puede deshacer.">
                                Cerrar Turno
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @if (t.Movimientos.Any())
        {
            <h5 class="mb-2">Movimientos del turno</h5>
            <div class="table-responsive mb-3">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Monto</th>
                            <th>Motivo</th>
                            <th>Fecha/Hora</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in t.Movimientos.OrderByDescending(x => x.FechaHora))
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@m.Tipo</span></td>
                                <td>@m.Monto.ToString("C")</td>
                                <td>@m.Motivo</td>
                                <td class="text-muted small">@m.FechaHora.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <div class="mt-3">
        <a asp-page="/Operaciones/TurnoCaja/Historial" class="btn btn-outline-secondary btn-sm">Ver historial de turnos</a>
    </div>
</section>
