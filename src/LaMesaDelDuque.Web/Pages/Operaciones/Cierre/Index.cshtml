@page
@model LaMesaDelDuque.Web.Pages.Operaciones.Cierre.IndexModel
@{ ViewData["Title"] = "Cierre de Día"; ViewData["ActiveTab"] = "Cierre"; }
@Html.AntiForgeryToken()

<section class="lmd-page-header rounded-top"><h1>Cierre de Día</h1><p class="lmd-page-subtitle">Apertura, cierre de caja e historial.</p></section>

<section class="bg-white p-3 rounded-bottom">
    @if (!string.IsNullOrWhiteSpace(Model.ToastError))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3" role="alert">@Model.ToastError<button type="button" class="btn-close" aria-label="Cerrar"></button></div>
    }

    @if (Model.CierreAbierto is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
            <span class="fw-bold">Día abierto:</span> @Model.CierreAbierto.Fecha.ToString("dd/MM/yyyy")
        </div>
        <form method="post" asp-page-handler="Cerrar">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Efectivo contado en caja</label>
                    <input type="number" step="0.01" min="0" name="EfectivoReal" class="form-control" required />
                    <div class="form-text">El sistema calculará el esperado desde los pagos del día.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Tarjeta / QR / transferencia contada</label>
                    <input type="number" step="0.01" min="0" name="TarjetaReal" class="form-control" required />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-danger w-100 lmd-confirm-destructive" data-confirm-message="¿Cerrar el día? Esta acción no se puede deshacer.">Cerrar Día</button>
                </div>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-md-8">
                    <label class="form-label">Observación del cierre</label>
                    <textarea name="Observacion" class="form-control" rows="3" maxlength="500"></textarea>
                    <div class="form-text">Obligatoria si hay diferencia entre efectivo/tarjeta real y sistema.</div>
                </div>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-warning mb-3">No hay día abierto hoy. Abrí el día para comenzar a operar.</div>
        <form method="post" asp-page-handler="Abrir">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">Abrir Día</button>
        </form>
    }


    <hr class="my-4" />
    <h5 class="mb-3">Ventas por canal</h5>
    <div class="row g-3 mb-2">
        @if (!Model.CanalesHoy.Any())
        {
            <div class="col-12"><div class="alert alert-info py-2 mb-0">Sin ventas por canal para hoy.</div></div>
        }
        @foreach (var canal in Model.CanalesHoy)
        {
            <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted small">@canal.Nombre</div>
                    <div class="fs-4 fw-bold">@canal.TotalVendido.ToString("C")</div>
                    <div class="small text-muted">@canal.Pedidos pedidos · @canal.Pagados pagados</div>
                </div>
            </div>
        }
    </div>
    <hr class="my-4" />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Personal de la jornada (hoy)</h5>
        <a asp-page-handler="Exportar" class="btn btn-outline-dark btn-sm">Exportar reporte PDF</a>
    </div>
    <div class="table-responsive mb-2">
        <table class="table table-sm align-middle">
            <thead>
                <tr><th>Nombre</th><th>Rol</th><th>Entrada</th><th>Salida</th><th>Abrió caja</th></tr>
            </thead>
            <tbody>
            @if (!Model.Personal.Any())
            {
                <tr><td colspan="5" class="text-muted text-center py-3">Sin registros de personal para hoy.</td></tr>
            }
            @foreach (var p in Model.Personal)
            {
                <tr>
                    <td>@p.NombreCompleto</td>
                    <td><span class="badge bg-secondary">@p.Rol</span></td>
                    <td>@(p.Entrada.HasValue ? p.Entrada.Value.ToLocalTime().ToString("HH:mm") : "—")</td>
                    <td>@(p.Salida.HasValue ? p.Salida.Value.ToLocalTime().ToString("HH:mm") : "—")</td>
                    <td>@(p.AbrioCaja ? "Sí" : "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <hr class="my-4" />
    <h5 class="mb-3">Historial de cierres</h5>
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr><th>Fecha</th><th>Estado</th><th>Ventas</th><th>Ef. Sistema</th><th>Ef. Real</th><th>Dif. Ef.</th><th>Tarj./QR Sistema</th><th>Tarj./QR Real</th><th>Dif. Tarj./QR</th><th>Pedidos</th><th>Cancel.</th><th>Merma</th><th>Hora cierre</th></tr>
            </thead>
            <tbody>
            @if (!Model.Historial.Any())
            {
                <tr><td colspan="9" class="text-muted text-center py-3">Sin historial registrado.</td></tr>
            }
            @foreach (var c in Model.Historial)
            {
                <tr>
                    <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge @(c.EsCerrado ? "bg-secondary" : "bg-success")">@(c.EsCerrado ? "Cerrado" : "Abierto")</span></td>
                    <td>@c.TotalVentas.ToString("C")</td>
                    <td>@c.TotalEfectivo.ToString("C")</td>
                    <td>@c.EfectivoReal.ToString("C")</td>
                    <td class="@(c.DiferenciaEfectivo < 0 ? "text-danger" : c.DiferenciaEfectivo > 0 ? "text-success" : "")">@c.DiferenciaEfectivo.ToString("C")</td>
                    <td>@c.TotalTarjeta.ToString("C")</td>
                    <td>@c.TarjetaReal.ToString("C")</td>
                    <td class="@(c.DiferenciaTarjeta < 0 ? "text-danger" : c.DiferenciaTarjeta > 0 ? "text-success" : "")">@c.DiferenciaTarjeta.ToString("C")</td>
                    <td>@c.TotalPedidos</td>
                    <td>@c.Cancelados</td>
                    <td>@c.TotalMerma.ToString("C")</td>
                    <td class="text-muted small">@(c.CerradoEn.HasValue ? c.CerradoEn.Value.ToLocalTime().ToString("HH:mm") : "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
