@page
@model LaMesaDelDuque.Web.Pages.Admin.Reportes.IndexModel
@{
    ViewData["Title"] = "Reportes";
}

<section class="lmd-page-header rounded-top">
    <div>
        <h1>Reportes</h1>
        <p class="lmd-page-subtitle">Exportación gerencial de ventas, inventario y mermas por rango de fechas.</p>
    </div>
</section>

<section class="bg-white border-top-0 p-4 rounded-bottom">
    @if (!string.IsNullOrWhiteSpace(Model.ToastError))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3" data-lmd-toast="true" role="alert">
            @Model.ToastError
            <button type="button" class="btn-close" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-3">
        <div class="col-md-6 col-xl-3">
            <article class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Ventas PDF</h2>
                    <p class="text-muted small flex-grow-1">Resumen gerencial de ventas por día, método de pago y productos principales.</p>
                    <form method="get" asp-page-handler="VentasPdf" class="vstack gap-2">
                        <div>
                            <label class="form-label small" for="ventas-pdf-desde">Desde</label>
                            <input id="ventas-pdf-desde" class="form-control form-control-sm" type="date" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
                        </div>
                        <div>
                            <label class="form-label small" for="ventas-pdf-hasta">Hasta</label>
                            <input id="ventas-pdf-hasta" class="form-control form-control-sm" type="date" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
                        </div>
                        <button class="btn btn-sm lmd-action-primary mt-2" type="submit">Descargar PDF</button>
                    </form>
                </div>
            </article>
        </div>

        <div class="col-md-6 col-xl-3">
            <article class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Ventas Excel</h2>
                    <p class="text-muted small flex-grow-1">Detalle auditable de ventas, pagos, productos y totales por día.</p>
                    <form method="get" asp-page-handler="VentasExcel" class="vstack gap-2">
                        <div>
                            <label class="form-label small" for="ventas-excel-desde">Desde</label>
                            <input id="ventas-excel-desde" class="form-control form-control-sm" type="date" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
                        </div>
                        <div>
                            <label class="form-label small" for="ventas-excel-hasta">Hasta</label>
                            <input id="ventas-excel-hasta" class="form-control form-control-sm" type="date" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
                        </div>
                        <button class="btn btn-sm lmd-action-success mt-2" type="submit">Descargar Excel</button>
                    </form>
                </div>
            </article>
        </div>

        <div class="col-md-6 col-xl-3">
            <article class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Kardex Excel</h2>
                    <p class="text-muted small flex-grow-1">Inventario con stock actual, costos y mermas acumuladas del período.</p>
                    <form method="get" asp-page-handler="KardexExcel" class="vstack gap-2">
                        <div>
                            <label class="form-label small" for="kardex-excel-desde">Desde</label>
                            <input id="kardex-excel-desde" class="form-control form-control-sm" type="date" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
                        </div>
                        <div>
                            <label class="form-label small" for="kardex-excel-hasta">Hasta</label>
                            <input id="kardex-excel-hasta" class="form-control form-control-sm" type="date" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
                        </div>
                        <button class="btn btn-sm lmd-action-success mt-2" type="submit">Descargar Excel</button>
                    </form>
                </div>
            </article>
        </div>

        <div class="col-md-6 col-xl-3">
            <article class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Mermas PDF</h2>
                    <p class="text-muted small flex-grow-1">Reporte de desperdicio, costo estimado, responsables y motivos registrados.</p>
                    <form method="get" asp-page-handler="MermasPdf" class="vstack gap-2">
                        <div>
                            <label class="form-label small" for="mermas-pdf-desde">Desde</label>
                            <input id="mermas-pdf-desde" class="form-control form-control-sm" type="date" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
                        </div>
                        <div>
                            <label class="form-label small" for="mermas-pdf-hasta">Hasta</label>
                            <input id="mermas-pdf-hasta" class="form-control form-control-sm" type="date" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
                        </div>
                        <button class="btn btn-sm lmd-action-primary mt-2" type="submit">Descargar PDF</button>
                    </form>
                </div>
            </article>
        </div>
    </div>
</section>
