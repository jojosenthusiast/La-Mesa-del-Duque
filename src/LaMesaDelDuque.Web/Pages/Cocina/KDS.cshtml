@page
@model LaMesaDelDuque.Web.Pages.Cocina.KDSModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KDS — La Mesa del Duque</title>
    <link rel="stylesheet" href="~/css/marca.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body class="lmd-kds-body">
    <header class="lmd-kds-header">
        <div class="lmd-kds-header__left">
            <h1 class="lmd-kds-titulo">Cocina</h1>
            <span id="lmd-kds-reloj" class="lmd-kds-reloj">--:--</span>
        </div>
        <nav class="lmd-kds-tabs">
            <button class="lmd-kds-tab lmd-kds-tab--activo" data-estacion="Todas">Todas</button>
            <button class="lmd-kds-tab" data-estacion="Parrilla">Parrilla</button>
            <button class="lmd-kds-tab" data-estacion="Fria">Fría</button>
            <button class="lmd-kds-tab" data-estacion="Caliente">Caliente</button>
            <button class="lmd-kds-tab" data-estacion="Bar">Bar</button>
            <button class="lmd-kds-tab" data-estacion="Expo">Expo</button>
        </nav>
        <div class="lmd-kds-header__right">
            <span id="lmd-kds-contador" class="lmd-kds-contador">0 ordenes</span>
            <div id="lmd-kds-indicador-visual" class="lmd-kds-indicador"></div>
        </div>
    </header>

    <main class="lmd-kds-main">
        <div id="lmd-kds-grid" class="lmd-kds-grid">
            @foreach (var orden in Model.Ordenes)
            {
                var minutos = (int)(DateTime.UtcNow - orden.HoraRecibido).TotalMinutes;
                var colorClass = minutos > 15 ? "lmd-kds-card--alert"
                    : minutos >= 5 ? "lmd-kds-card--warn"
                    : "lmd-kds-card--fresh";
                var mesaTexto = orden.MesaNumero.HasValue ? $"Mesa {orden.MesaNumero}"
                    : orden.TipoServicio == "ParaLlevar" ? "Para llevar" : "Sin mesa";

                <article class="lmd-kds-card @colorClass" data-orden-id="@orden.Id">
                    <header class="lmd-kds-card__header">
                        <span class="lmd-kds-card__mesa">@mesaTexto</span>
                        <span class="lmd-kds-card__timer" data-hora-recibido="@orden.HoraRecibido.ToString("O")">
                            @string.Format("{0:D2}:{1:D2}", minutos, (int)((DateTime.UtcNow - orden.HoraRecibido).TotalSeconds % 60))
                        </span>
                    </header>
                    <div class="lmd-kds-card__body">
                        <div class="lmd-kds-card__producto">@orden.ProductoNombre</div>
                        <div class="lmd-kds-card__cantidad">x@orden.Cantidad</div>
                    </div>
                    <footer class="lmd-kds-card__footer">
                        <button class="lmd-kds-btn-listo" data-orden-id="@orden.Id">LISTO</button>
                    </footer>
                </article>
            }
        </div>
    </main>

    @Html.AntiForgeryToken()
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/cocina-kds.js" asp-append-version="true"></script>
</body>
</html>
